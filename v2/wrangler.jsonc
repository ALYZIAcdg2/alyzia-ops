{
  // ALYZIA OPS v2 — worker de construction/validation, séparé du worker de
  // production "alyzia-ops". Branché sur les MÊMES ressources D1/R2 que la
  // prod pour pouvoir être testé sur de vraies données sans rien dupliquer.
  //
  // Pas de "triggers.crons" ici volontairement : tant que ce worker est en
  // construction, aucun traitement automatique ne doit tourner en parallèle
  // de celui du worker de prod (risque de double traitement du même mail /
  // de la même liste). Le pipeline est déclenché manuellement via un
  // endpoint admin le temps de la validation. Le cron sera ajouté seulement
  // au moment de la bascule finale.
  "name": "alyzia-ops-v2",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-06",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "SARIA",
      "service": "saria-seatmap"
    }
  ],

  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "alyzia-ops-db",
      "database_id": "2881327d-f2dd-4037-a395-f7095b32c69c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "OPS_FILES",
      "bucket_name": "alyzia-ops-files"
    }
  ]
}
