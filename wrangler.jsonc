{
  "name": "alyzia-ops",
  "main": "src/index.js",
  "compatibility_date": "2025-08-01",

  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "alyzia-ops-db",
      "database_id": "2881327d-f2dd-4037-a395-f7095b32c69c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "OPS_FILES",
      "bucket_name": "alyzia-ops-files"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
