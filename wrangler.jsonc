{
  "name": "alyzia-ops",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-06",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "SARIA",
      "service": "saria-seatmap"
    }
  ],

  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "alyzia-ops-db",
      "database_id": "2881327d-f2dd-4037-a395-f7095b32c69c"
    }
  ]
}
"r2_buckets": [
  {
    "binding": "OPS_FILES",
    "bucket_name": "alyzia-ops-files"
  }
]
